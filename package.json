{
  "name": "dr-dubber-pro",
  "version": "1.0.1",
  "description": "DR Dubber Pro - Khmer Edition AI Dubbing Studio",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:css",
    "start": "electron .",
    "server": "node backend/server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/css/tailwind-src.css -o frontend/css/tailwind-built.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i frontend/css/tailwind-src.css -o frontend/css/tailwind-built.css --watch",
    "predist": "npm run build:css",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.drdubber.pro",
    "productName": "DR Dubber Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "frontend/**/*",
      "assets/**/*",
      "whisper_engine/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "backend/python/**/*",
      "whisper_engine/**/*"
    ],
    "mac": {
      "icon": "assets/drdubberpro.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "icon": "assets/drdubberpro.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DR Dubber Pro"
    }
  },
  "keywords": [
    "ai-dubber",
    "khmer-tts",
    "video-dubbing",
    "spleeter",
    "ffmpeg"
  ],
  "author": "AI Studio",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "^3.4.17"
  },
  "productName": "DR Dubber Pro"
}
