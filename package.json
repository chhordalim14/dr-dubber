{
  "name": "dr-dubber-pro",
  "version": "1.5.1",
  "description": "DR Dubber Pro - Khmer Edition AI Dubbing Studio",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:css || true",
    "start": "electron .",
    "server": "node backend/server.js",
    "test": "node --test",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/css/tailwind-src.css -o frontend/css/tailwind-built.css --minify || true",
    "watch:css": "tailwindcss -c tailwind.config.js -i frontend/css/tailwind-src.css -o frontend/css/tailwind-built.css --watch",
    "predist": "npm run build:css",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "predist:win": "node -e \"require('fs').existsSync('backend/models/UVR-MDX-NET-Voc_FT.onnx') || (console.error('Missing backend/models/UVR-MDX-NET-Voc_FT.onnx (the Isolate BGM model): run setup_python_env.bat first.'), process.exit(1))\"",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.drdubber.pro",
    "productName": "DR Dubber Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "!backend/demucs-env/**/*",
      "!backend/spleeter-env/**/*",
      "frontend/**/*",
      "assets/**/*",
      "!assets/**/*.{mp4,mkv,mov,avi,webm,ts,flv,wmv}",
      "whisper_engine/**/*",
      "!whisper_engine/venv/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "backend/bin/**/*",
      "backend/python_env/**/*",
      "backend/python/**/*",
      "backend/pretrained_models/**/*",
      "backend/models/**/*",
      "whisper_engine/**/*"
    ],
    "mac": {
      "icon": "assets/logo.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DR Dubber Pro"
    }
  },
  "keywords": [
    "ai-dubber",
    "khmer-tts",
    "video-dubbing",
    "demucs",
    "ffmpeg"
  ],
  "author": "AI Studio",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.17"
  },
  "productName": "DR Dubber Pro"
}
