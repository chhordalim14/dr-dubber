# Copy this file to .env and adjust as needed.
# None of these are required to run the app — every value has a working
# default baked into backend/server.js and main.js. Set one here only if
# you need to override that default for your machine/setup.

# Port the local backend server listens on.
# Default: 3001
PORT=3001

# Absolute path to the directory used for uploads, separated audio, exports,
# logs, etc. Default: <project-root>/storage (set automatically by main.js
# based on the OS-appropriate app-data directory in packaged builds).
# APP_STORAGE_DIR=

# Explicit path to a Python executable to use for the backend's ML tooling
# (Demucs vocal separation, Whisper transcription, etc.). If unset, the app
# auto-detects a working Python by checking the bundled backend/python_env,
# then common system locations. Set this if auto-detection picks the wrong
# interpreter on your machine.
# PYTHON_PATH=
# PYTHON_BIN=

# Gemini / DAI API keys are NOT configured here — they're entered per-user
# in the app's Settings UI and sent with each request, not read from env vars.
